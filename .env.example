# LPTV 环境变量示例
# 复制为 .env 并填入实际值

# 后端端口
PORT=3000

# 前端允许的 Origin 白名单（生产环境必须设置，逗号分隔）
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# IPTV345 密钥（可从页面 JS 中提取，定期更新）
IPTV345_TOKEN=your_token_here
IPTV345_KRKAN=your_krkan_key_here
IPTV345_ARNAK=your_arnak_key_here
IPTV345_NBYSB=your_nbysb_key_here
